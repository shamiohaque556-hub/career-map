# ── Copy this to .env for local development. NEVER commit .env. ──────────────
# Generate a new SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=put_a_long_random_string_here
GEMINI_API_KEY=your_gemini_api_key

# Local Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_NAME=personality_db
DB_USER=postgres
DB_PASS=your_local_password

# Production: hosts like Render/Neon/Supabase give you one URL instead
# DATABASE_URL=postgresql://user:pass@host/dbname

# Comma-separated admin login emails for the content editor (admin.html)
ADMIN_EMAILS=you@example.com

# Production only: your deployed frontend origin(s), comma-separated
# FRONTEND_ORIGIN=https://your-frontend.netlify.app
